# Copy to .env and adjust. Everything is optional.

# address and port the app is published on
#APP_PORT=8300

# names of the built images: <IMAGE_PREFIX>-app:<IMAGE_TAG>, <IMAGE_PREFIX>-server:<IMAGE_TAG>
# (set the prefix to your registry to push them, e.g. registry.example.com/tools/excalidraw)
#IMAGE_PREFIX=excalidraw-selfhost
#IMAGE_TAG=latest

# S3 credentials (also set on the bundled RustFS)
#S3_ACCESS_KEY_ID=rustfsadmin
#S3_SECRET_ACCESS_KEY=rustfsadmin
#S3_BUCKET=excalidraw

# to use an external S3 instead of the bundled RustFS
#S3_ENDPOINT=http://minio.local:9000
#S3_REGION=us-east-1
