# Пример .env для docker-compose-staging.yaml. Один файл — два потребителя:
# docker compose (EXCALIDRAW_PORT) и контейнер server (env_file: всё остальное).
# Реальные значения — в CI/CD File-переменной ENV_CONTAINER_EXCALIDRAW_STAGING, не в git.

# --- Порт, публикуемый НАРУЖУ на VM ---
# Не должен конфликтовать с другими стендами на той же VM.
# Стенд отдаёт HTTP; для работы комнат и ссылок перед ним нужен HTTPS (см. README.md).
EXCALIDRAW_PORT=8450

# --- S3: существующий RustFS контура ---
# Адрес S3 API (не веб-консоли), как он виден с VM стенда.
S3_ENDPOINT=http://RUSTFS_HOST:9000
S3_REGION=us-east-1
# Бакет стенда, заводится заранее.
S3_BUCKET=excalidraw-staging
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
# Адресация path-style (http://host/bucket/key) — так работают RustFS и MinIO.
S3_FORCE_PATH_STYLE=true
